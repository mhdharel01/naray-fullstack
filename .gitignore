# Dependencies
**/node_modules/
**/vendor/

# Environment and sensitive credentials
.env
.env.*
!.env.example
*.ppk
*.pem
id_rsa*
*.key

# Laravel Backend specific
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*
/bootstrap/cache/*.php
!/bootstrap/cache/.gitignore
/public/storage
/storage/app/public/*
!/storage/app/public/.gitignore

# Frontend build tracked for zero-build server deployment
!frontend/dist/

# Archives & Temporary files
*.zip
*.tar.gz
*.rar
scratch_*.php

# IDE & OS files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Graphify / AI agent caches
graphify-out/
.agents/
